{
    "name": "vincentbitter/healthy",
    "description": "Healthy plugin for WordPress",
    "type": "wordpress-plugin",
    "scripts": {
        "test": "export XDEBUG_MODE=coverage && phpunit --display-errors --display-warnings --display-phpunit-deprecations --log-junit ../test-report/unit/phpunit-junit.xml --coverage-clover ../test-report/unit/coverage.xml -c ../tests/phpunit.xml.dist $PHPUNIT_ARGS"
    },
    "autoload": {
        "psr-4": {
            "Healthy\\": "lib/"
        }
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^7.0.0",
        "phpunit/phpunit": "^13.2.4",
        "brain/monkey": "^2.7",
        "wp-coding-standards/wpcs": "^3.3"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}