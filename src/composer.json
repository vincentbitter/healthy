{
    "name": "vincentbitter/healthy",
    "description": "Healthy plugin for WordPress",
    "type": "wordpress-plugin",
    "scripts": {
        "test": "export XDEBUG_MODE=coverage && phpunit --display-errors --display-warnings --display-phpunit-deprecations --coverage-clover ../tests/coverage.xml -c ../tests/phpunit.xml.dist $PHPUNIT_ARGS"
    },
    "autoload": {
        "psr-4": {
            "Healthy\\": "lib/"
        }
    },
    "require-dev": {
        "php-stubs/wordpress-stubs": "^6.0",
        "phpunit/phpunit": "^13.1",
        "brain/monkey": "^2.7"
    }
}