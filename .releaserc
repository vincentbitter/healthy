{
    "branches": [
        {
            "name": "main",
            "channel": "beta",
            "prerelease": "beta"
        },
        {
            "name": "release"
        }
    ],
    "plugins": [
        "@semantic-release/commit-analyzer",
        "@semantic-release/release-notes-generator",
        [
            "@semantic-release/changelog",
            {
                "changelogFile": "CHANGELOG.md"
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "sed -i 's/Version: .*/Version: ${nextRelease.version}/' src/healthy.php && sed -i \"s/define( 'HEALTHY_VERSION', '.*' );/define( 'HEALTHY_VERSION', '${nextRelease.version}' )/\" src/healthy.php && sed -i 's/Stable tag: .*/Stable tag: ${nextRelease.version}/' src/readme.txt"
            }
        ],
        [
            "@semantic-release/exec",
            {
                "prepareCmd": "node build.js && cp -r dist healthy && zip -r healthy-${nextRelease.version}.zip healthy && rm -rf healthy"
            }
        ],
        [
            "@semantic-release/git",
            {
                "assets": [
                    "CHANGELOG.md",
                    "src/healthy.php"
                ],
                "message": "chore(release): ${nextRelease.version} [skip ci]"
            }
        ],
        [
            "@semantic-release/github",
            {
                "assets": [
                    {
                        "path": "healthy-*.zip",
                        "label": "healthy-${nextRelease.version}.zip"
                    }
                ]
            }
        ]
    ]
}